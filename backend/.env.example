NODE_ENV=development
APP_NAME=QueueIt API
APP_VERSION=0.1.0
PORT=5000
HOST=0.0.0.0
TRUST_PROXY=false
API_PREFIX=/api
API_VERSION=v1
MONGODB_URI=mongodb://127.0.0.1:27017/queueit
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_RETRY_ATTEMPTS=5
MONGODB_RETRY_DELAY_MS=2000
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_HELO_NAME=queueit.local
SMTP_TIMEOUT_MS=10000
PASSWORD_RESET_URL=http://localhost:3000/reset-password
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@queueit.local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SOCKET_CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=logs
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FEATURE_REGISTRATION_ENABLED=true
FEATURE_QUEUE_ENABLED=false
AI_ENABLED=false
# Provider remains disabled unless an approved provider adapter is configured.
AI_PROVIDER=disabled
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=400
AI_TIMEOUT_MS=8000
AI_MAX_CONTEXT_CHARS=6000
AI_RATE_LIMIT_MAX=20
AI_DEFAULT_SERVICE_MINUTES=5
ACCESS_TOKEN_COOKIE_NAME=accessToken
REFRESH_TOKEN_COOKIE_NAME=refreshToken
PASSWORD_EXPIRES_DAYS=90
