# QueueIt Docker Compose environment example.
# Copy to .env and replace placeholder secrets before running anything beyond local evaluation.

APP_NAME=QueueIt API
APP_VERSION=0.1.0
MONGO_INITDB_DATABASE=queueit
MONGODB_URI=mongodb://mongodb:27017/queueit
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-a-secure-jwt-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-secure-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost
CORS_CREDENTIALS=true
SOCKET_CORS_ORIGIN=http://localhost

REDIS_ENABLED=true
LOG_LEVEL=info
LOG_TO_FILE=false
FEATURE_REGISTRATION_ENABLED=true
FEATURE_QUEUE_ENABLED=true

VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=http://localhost
NGINX_PORT=80
