# QueueIt environment example.
# Copy to .env for local Docker Compose or to .env.production for a production host.
# Never commit real secrets, production domains, credentials, IP allowlists, or provider-specific values.

# -----------------------------------------------------------------------------
# Backend runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_NAME="QueueIt API"
APP_VERSION=0.1.0
PORT=5000
HOST=0.0.0.0
TRUST_PROXY=true
API_PREFIX=/api
API_VERSION=v1

# -----------------------------------------------------------------------------
# MongoDB
# Local Compose default: mongodb://mongodb:27017/queueit
# Production: use a managed MongoDB connection string such as MongoDB Atlas.
# Include credentials in the deployment secret store only, not in Git.
# -----------------------------------------------------------------------------
MONGO_INITDB_DATABASE=queueit
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority"
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_RETRY_ATTEMPTS=5
MONGODB_RETRY_DELAY_MS=2000

# -----------------------------------------------------------------------------
# Redis
# Local Compose default: redis://redis:6379
# Production: use a managed or otherwise private Redis endpoint. Prefer TLS where supported.
# Examples: rediss://:<password>@<host>:<port> or redis://:<password>@<private-host>:6379
# -----------------------------------------------------------------------------
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:REDIS_PORT
REDIS_ENABLED=true

# -----------------------------------------------------------------------------
# JWT and session cookies
# Use unique, high-entropy values for both secrets in production.
# Cookies are marked secure automatically when NODE_ENV=production; serve only over HTTPS.
# -----------------------------------------------------------------------------
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
REFRESH_TOKEN_EXPIRES_IN=7d
ACCESS_TOKEN_COOKIE_NAME=accessToken
REFRESH_TOKEN_COOKIE_NAME=refreshToken

# -----------------------------------------------------------------------------
# OAuth
# Configure callback URL to match the public HTTPS origin and API prefix.
# Leave blank when the provider is not enabled/configured.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-app.example.com/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Notifications and media integrations
# Leave blank when unused. Store real credentials in your deployment secret manager.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.example
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# CORS and Socket.IO
# Set origins to the exact public HTTPS origin that serves the frontend.
# Use comma-separated values only if the backend supports your intended origin format.
# -----------------------------------------------------------------------------
CORS_ORIGIN=https://your-app.example.com
CORS_CREDENTIALS=true
SOCKET_CORS_ORIGIN=https://your-app.example.com
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_PING_INTERVAL_MS=25000
SOCKET_CONNECT_TIMEOUT_MS=45000
SOCKET_ACK_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Logging, rate limits, and feature flags
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_DIR=logs
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FEATURE_REGISTRATION_ENABLED=true
FEATURE_QUEUE_ENABLED=false
PASSWORD_EXPIRES_DAYS=90

# -----------------------------------------------------------------------------
# Frontend build-time variables
# Vite embeds these during image build; rebuild frontend after changing them.
# Same-origin values are recommended behind Nginx.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=https://your-app.example.com

# -----------------------------------------------------------------------------
# Nginx / host networking
# Terminate HTTPS at your load balancer or an HTTPS-capable reverse proxy in front of this container.
# -----------------------------------------------------------------------------
NGINX_PORT=80
